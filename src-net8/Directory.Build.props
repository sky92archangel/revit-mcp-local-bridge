<!--
================================================================================
 Revit Command Bridge — .NET 8 适配器共享构建属性 / Shared Build Properties
================================================================================
 本文件被 src-net8/ 下各年份 .csproj 导入，提供共享的 MSBuild 属性与 ItemGroup：
   - 编译设置（Windows Forms、WPF、平台目标、优化等）
   - 通用源码链接（从 ../src/ 引入 .cs 文件）
   - Revit API 引用（通过 RevitAPI / RevitAPIUI 环境变量）
   - NuGet 依赖（System.Text.Json 8.0.x）
 各年份的 .csproj 自身声明 TargetFramework。

 This file is imported by every year‑specific .csproj under src-net8/. It provides
 shared MSBuild properties and ItemGroups:
   - Compilation settings (Windows Forms, WPF, platform target, optimizations, etc.)
   - Common source‑file links (from ../src/)
   - Revit API references (via RevitAPI / RevitAPIUI environment variables)
   - NuGet dependencies (System.Text.Json 8.0.x)
 Each year‑specific .csproj declares its own TargetFramework.
================================================================================
-->
<Project>
  <!--
    .NET 8 适配器项目共享 ItemGroup（源码链接、NuGet 包、API 引用）。
    各年份的 .csproj 独立声明 TargetFramework（SDK 需要在 .csproj 中直接读到）。

    Shared ItemGroup for .NET 8 adapter projects (source links, NuGet packages, API refs).
    Each year‑specific .csproj declares its own TargetFramework (the SDK requires it in the project file directly).
  -->

  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>RevitCommandBridge</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\*.cs" Link="src/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI" Condition="'$(RevitAPI)' != ''">
      <HintPath>$(RevitAPI)</HintPath>
    </Reference>
    <Reference Include="RevitAPIUI" Condition="'$(RevitAPIUI)' != ''">
      <HintPath>$(RevitAPIUI)</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.4" />
  </ItemGroup>
</Project>
